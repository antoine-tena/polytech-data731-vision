# Image of frontend/: the Streamlit dashboard.
# Built from the root of the repo (compose.yaml, or podman build -f <directory>/Containerfile .).
# uv only, never pip; a non-root user ([HARDENED-CONTAINERS]).
FROM ghcr.io/astral-sh/uv:python3.14-trixie-slim@sha256:d8e732839dfc4225a1ff698803b478b2223c05636c055d3add41ab9dbec0f315
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never PYTHONUNBUFFERED=1
COPY backend/ /srv/backend/
WORKDIR /srv/frontend
COPY frontend/pyproject.toml frontend/uv.lock frontend/.python-version ./
RUN uv sync --locked --no-dev --no-install-project
COPY frontend/ ./
RUN uv sync --locked --no-dev && useradd --system --create-home app && chown -R app /srv
# The image's environment first in PATH: the server starts without uv, which would want to
# write its cache into a read-only file system ([HARDENED-CONTAINERS]).
ENV PATH="/srv/frontend/.venv/bin:$PATH"
USER app
EXPOSE 8501
CMD ["streamlit", "run", "app.py", "--server.address", "0.0.0.0", "--server.port", "8501"]
